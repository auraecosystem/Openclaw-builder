{
    "name": "breakout_quick",
    "direction": "long",
    "fill_mode": "next_day_open",
    "equity_fraction": 0.5,
    "pipeline": [
        { "type": "exclude_etf" },
        { "type": "regime_ema", "when": "@regime" },
        { "type": "price_floor", "min": "@min_price" },
        { "type": "volume_floor", "min": "@min_vol" },
        { "type": "near_52w_high", "max_dist": "@max_dist_52w", "when": "@use_52w" },
        { "type": "prior_move", "min": "@min_prior_move", "when": "@use_prior_move" },
        { "type": "rs_percentile", "timeframes": ["1m", "3m", "6m"], "min_pct": "@rs_pct", "when": "@use_rs" },
        { "type": "extension_cap", "max_atr_above": 1.0, "when": "@use_extension" },
        { "type": "adr_floor", "min_pct": "@min_adr_pct", "when": "@use_adr" },
        { "type": "consolidation", "min_days": "@min_consol_days", "max_range": "@max_range_pct", "when": "@use_consol" },
        { "type": "pattern_any", "patterns": ["vcp", "flag"], "when": "@use_patterns" },
        { "type": "breakout_above", "ref": "consol_high", "vol_spike": "@vol_ratio", "adv_min": "@min_adv", "stop_fallback_pct": "@stop_fallback_pct" }
    ],
    "stop": { "type": "atr_capped_low", "fallback_pct": "@stop_fallback_pct" },
    "exits": [
        { "type": "profit_target", "min_bars": 5 },
        { "type": "sma_trail", "period": 10 },
        { "type": "stop_loss" }
    ],
    "params": {
        "regime": { "value": false, "evolvable": true },
        "use_52w": { "value": false, "evolvable": true },
        "use_prior_move": { "value": false, "evolvable": true },
        "use_rs": { "value": false, "evolvable": true },
        "use_extension": { "value": false, "evolvable": true },
        "use_adr": { "value": false, "evolvable": true },
        "use_consol": { "value": false, "evolvable": true },
        "use_patterns": { "value": false, "evolvable": true },
        "min_price": { "value": 1.0, "min": 1.0, "max": 50.0 },
        "min_vol": { "value": 10000.0, "min": 10000.0, "max": 1000000.0 },
        "rs_pct": { "value": 0.50, "min": 0.01, "max": 0.99 },
        "max_dist_52w": { "value": 0.50, "min": 0.05, "max": 1.0 },
        "min_prior_move": { "value": 0.0, "min": 0.0, "max": 1.0 },
        "min_adr_pct": { "value": 0.01, "min": 0.005, "max": 0.10 },
        "min_consol_days": { "value": 0, "min": 0, "max": 20 },
        "max_range_pct": { "value": 0.40, "min": 0.05, "max": 1.0 },
        "vol_ratio": { "value": 1.0, "min": 1.0, "max": 4.0 },
        "min_adv": { "value": 0.0, "min": 0.0, "max": 500000000.0 },
        "stop_fallback_pct": { "value": 0.05, "min": 0.01, "max": 0.15 }
    }
}
